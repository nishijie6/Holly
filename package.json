{
  "name": "holly",
  "license": "MIT",
  "description": "A local QQ chat agent with configurable LLMs, memory and an operator dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/nishijie6/Holly.git"
  },
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env dist/main.js",
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx main.ts",
    "llm:test": "NODE_USE_ENV_PROXY=1 tsx test.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "eval:proactive": "NODE_USE_ENV_PROXY=1 tsx proactive-eval.ts",
    "search:test": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx web-search.ts",
    "search-flow:test": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx search-flow-eval.ts",
    "db:migrate:qdrant-to-sqlite": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx migrate-qdrant-to-sqlite.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs holly",
    "pm2:status": "pm2 status holly"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "undici": "^8.11.2",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "pm2": "^7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
