{
  "name": "pybot-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "set NODE_USE_ENV_PROXY=1&& node --env-file-if-exists=.env dist/main.js",
    "dev": "set NODE_USE_ENV_PROXY=1&& node --env-file-if-exists=.env --import tsx main.ts",
    "llm:test": "set NODE_USE_ENV_PROXY=1&& tsx test.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "eval:proactive": "set NODE_USE_ENV_PROXY=1&& tsx proactive-eval.ts",
    "search:test": "set NODE_USE_ENV_PROXY=1&& node --env-file-if-exists=.env --import tsx web-search.ts",
    "search-flow:test": "set NODE_USE_ENV_PROXY=1&& node --env-file-if-exists=.env --import tsx search-flow-eval.ts",
    "ai-tone:test": "tsx ai-tone.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
