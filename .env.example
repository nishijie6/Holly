# Optional: copy to .env. Real values belong in .env or config.yaml, not here.
# npm run dev, npm start and PM2 load .env automatically.

# Used when database.provider=qdrant; overrides config.yaml's qdrant.api_key.
QDRANT_API_KEY=

# Optional alternatives to admin.user_ids and private_chat.bot_user_id.
# Admin IDs are comma-separated and added to those in config.yaml.
HOLLY_ADMIN_QQ_IDS=
HOLLY_BOT_QQ_ID=

# Optional local SearXNG endpoint (used only when search is enabled).
SEARXNG_URL=http://127.0.0.1:8888
